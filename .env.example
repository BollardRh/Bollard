# Copy to .env.local for local dev. Real values live in Vercel / Supabase, never in git.

# Chain (Robinhood Chain testnet)
CHAIN_ID=46630
RHC_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Supabase (server only)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contracts (from contracts/deployments/rhc-testnet.json after the Phase 7 deploy)
REGISTRY_RHC=
ATTESTERS_RHC=
FEEROUTER_RHC=
FEE_TOKEN_RHC=
ARENA_RHC=
GUARD_RHC=
IDENTITY_8004=0x8004A818BFB912233c491871b3d84c89A494BD9e
START_BLOCK_RHC=
CONFIRMATIONS=20
EXPLORER_URL=   # the Robinhood Chain testnet block explorer URL (used for links in the dashboard)

# Signing (gas only; holds nothing else)
POSTER_PRIVATE_KEY=

# Jobs and bot
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OPS_CHAT_ID=

# Attestation
# phala | local | dev (dev = synthetic quotes, testnet only)
DCAP_VERIFIER=phala
PHALA_VERIFY_URL=https://cloud-api.phala.com/api/v1/attestations/verify

# Local development only: let builders register http:// agent endpoints
ALLOW_HTTP_ENDPOINTS=0
